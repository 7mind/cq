cq.toml

.claude/
nix/pkg/cq-assets/.generated/
# direnv
.direnv/

# nix
result
result-*

# bun / node
node_modules/
.cache/
bun.lockb.tmp
*.log

# build output
dist/
build/
.next/
.vite/
.parcel-cache/
*.tsbuildinfo

# D68: prevent misplaced compiled output from being re-committed under package src/
nix/pkg/cq-ledgers/packages/*/src/**/*.js
nix/pkg/cq-ledgers/packages/*/src/**/*.d.ts
nix/pkg/cq-ledgers/packages/*/src/**/*.d.ts.map

# editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# cq runtime
var/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# @cq/ledger per-cwd scratch lockfiles and backup artifacts
.cq/.locks/
# Retained scratch backup directory.
.cq/.ledger-backup/
# Scratch/portable-dump registry, not primary storage.
.cq/ledgers.yaml

# scratch
/debug/
**/debug/

# CodeGraph local index (per-machine)
.codegraph/
.cq/.backup/
# Ledger archives are runtime artifacts, not source.
.cq/archive/
