{
  "name": "ledger-suite",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/cq-cli",
    "packages/cq-config",
    "packages/process-control",
    "packages/ledger",
    "packages/ledger-live",
    "packages/ledger-mcp",
    "packages/ledger-tui",
    "packages/ledger-web"
  ],
  "scripts": {
    "check": "tsc -b && bun run lint && bun test && bun run check:codex-installed-gate && bun run check:flake-enumeration",
    "check:codex-installed-gate": "cd ../../.. && nix build --no-link .#cq",
    "check:flake-enumeration": "cd ../../.. && nix flake show --all-systems --json",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "bun test --pass-with-no-tests",
    "test:attestation-postgres-required": "bash scripts/test-attestation-postgres-required.sh",
    "bench:store": "bun run packages/ledger/bench/storeBackendBench.ts",
    "bench:concurrent": "bun run packages/ledger/bench/proto/concurrentWriterSmoke.ts",
    "measure:tool-surface": "bun run scripts/measure-tool-surface.ts",
    "regen-bootstrap": "bun run scripts/regen-bootstrap.ts",
    "link-prompts": "bun run scripts/link-prompts.ts",
    "gen-prompt-catalog": "bun run packages/cq-config/scripts/gen-prompt-catalog.ts",
    "gen-agents": "bun run packages/ledger-web/scripts/gen-agents-catalogue.ts",
    "aggregate:role-tool-corpus": "bun run packages/cq-config/scripts/aggregate-role-tool-corpus.ts",
    "verify:role-tool-corpus": "CQ_T1325_VERIFY_RAW_CORPUS=1 bun test packages/cq-config/test/roleToolProfiles.test.ts",
    "probe:codex-role-tools": "bun run packages/cq-config/scripts/probe-codex-role-tool-profile.ts",
    "probe:codex-role-dispatch": "bun run packages/cq-config/scripts/probe-codex-role-dispatch.ts",
    "dispatch:codex-role": "bun run packages/cq-config/scripts/codex-role-dispatch.ts",
    "verify-packaged-prompt-surfaces": "bun run packages/ledger-mcp/scripts/verify-packaged-prompt-surfaces.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "gpt-tokenizer": "3.4.0",
    "globals": "^17.7.0",
    "node-gyp": "^13.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "trustedDependencies": [
    "node-pty"
  ]
}
